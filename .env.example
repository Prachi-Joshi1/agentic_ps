# Copy to .env (never commit .env, never put it in the Drive folder).

# Where skills/, data/, config/ and runs/ live. Point this at the Google Drive
# folder later; until then the repo's ./workspace is used.
# HARNESS_WORKSPACE=G:\My Drive\agenticps

# --- Free LLM keys: comma-separated, ONE KEY PER ACCOUNT/PROJECT ---
# Free-tier quotas are per Google project / Groq org, so two keys from the same
# account share one quota and add nothing.
GEMINI_API_KEYS=
GROQ_API_KEYS=

# --- Human handoff + chat trigger (Telegram @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat ids allowed to command the bot.
TELEGRAM_CHAT_IDS=

# --- Email trigger (Gmail: 2-step verification + app password, or OAuth token) ---
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
# IMAP_OAUTH_TOKEN=

# --- Secrets the agent may type but never sees: referenced as {{secret.NAME}} ---
# Resolved from SECRET_<NAME> here, or from Windows Credential Manager
# (service "agenticps", username NAME) via: python -m harness secret set NAME
SECRET_IRCTC_USERNAME=
SECRET_IRCTC_PASSWORD=
SECRET_UPI_ID=

# --- Browser ---
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CDP_PORT=9222
